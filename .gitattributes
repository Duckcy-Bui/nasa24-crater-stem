# Text hashes in the dataset manifest must remain stable across Linux/Windows.
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.zip binary
*.png binary
*.npy binary

# Preserve archived evidence bytes so SHA-256 survives checkout.
docs/evidence/s3-10/** -text whitespace=cr-at-eol
